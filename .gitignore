# Machine-local downloads, toolchains, vendor sources and build outputs.
# Keep empty directory structure in Git.
/downloads/**
!/downloads/**/
!/downloads/**/.gitkeep
# Vendor trees carry their own ignore exceptions; exclude the whole reference tree.
/downloads/atk-reference/

# Local machine-transfer bundles and their manifests.
/DDG-STM32MP257-learning-handoff-*.zip
/TRANSFER-INFO.txt
/TRANSFER-MANIFEST.sha256
/openstlinux/**
!/openstlinux/**/
!/openstlinux/**/.gitkeep
# Ignore entire component directories so vendor .gitignore negations cannot
# expose extracted source files. Keep ostl-linux/.gitkeep at the workspace level.
/openstlinux/sources/ostl-linux/*/
/build/**
!/build/**/
!/build/**/.gitkeep
/deploy/**
!/deploy/**/
!/deploy/**/.gitkeep

# Local configuration: keep shared configuration and examples tracked.
.env
.env.local
*.local.conf
*.local.mk

# Editor / OS temporary files.
*~
*.swp
*.swo
.DS_Store
Thumbs.db
__pycache__/
*.py[cod]

# M33 toolchains and downloaded vendor packages.
/toolchains/**
!/toolchains/**/
!/toolchains/**/.gitkeep
/third_party/**
!/third_party/**/
!/third_party/**/.gitkeep

# Eclipse / STM32CubeIDE workspace state (keep project descriptions tracked).
.metadata/
